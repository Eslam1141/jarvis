# Copy this file to .env and fill in your key.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# What Jarvis calls you (leave empty for "sir")
JARVIS_USER_NAME=

# auto = reply in the language you write in, en = always English, ar = always Arabic
JARVIS_LANGUAGE=auto

# How hard Jarvis thinks: low (fastest, cheapest) | medium | high | xhigh | max
JARVIS_EFFORT=medium

# Let Jarvis search the web (true/false)
JARVIS_WEB_SEARCH=true
